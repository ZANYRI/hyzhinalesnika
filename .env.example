# Порт приложения на сервере (чтобы не конфликтовать с первым сайтом на 3000)
PORT=3001

# ID организации в Контур.Отель (по умолчанию используется ваш ID)
NEXT_PUBLIC_KONTUR_HOTEL_ID=a8ca9db5-0cc4-4728-a9d1-0ecbd7092a07

# Опционально: отправка заявок обратного звонка в Telegram-бота
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сезонный эффект (осенний туман и падающие листья): true или false
NEXT_PUBLIC_AUTUMN_ATMOSPHERE=true

# Verified MAX profile or channel link (optional)
NEXT_PUBLIC_MAX_URL=
